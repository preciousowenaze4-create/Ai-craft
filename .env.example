# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY:
# Configure your Supabase project credentials in Settings > Secrets in AI Studio (backend only).
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# PAYMENT_SECRET_KEY / PAYSTACK_SECRET_KEY:
# Backend-only secret key for live checkout and transaction verification (never expose in client code).
PAYMENT_SECRET_KEY="MY_PAYMENT_SECRET_KEY"
# Optional manual USD -> NGN override (defaults to live market FX rate):
# PAYSTACK_USD_TO_NGN_RATE="1350"

# SERVER-SIDE GEMINI API KEY:
# Add GEMINI_API_KEY from Google AI Studio (aistudio.google.com) in Vercel Environment Variables (or Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# OWNER_ADMIN_EMAIL="preciousowenaze4@gmail.com"

# STAGE 2 (Future): Self-Hosted Open-Source GPU Model Endpoint (inactive in Stage 1):
# SELF_HOSTED_LLM_URL=""
# SELF_HOSTED_LLM_MODEL="self-hosted/open-source-coder"
# SELF_HOSTED_LLM_PROTOCOL="openai_compatible"
# SELF_HOSTED_LLM_API_KEY=""

# FREE AI MESH — automatic failover across free AI providers (no Gemini key required).
# Providers are tried in order: self-hosted → OpenAI-compatible → Groq → Cerebras →
# OpenRouter (:free models) → Mistral → HuggingFace → GitHub Models → Together →
# DeepInfra → Pollinations (keyless fallback). Rate-limited providers cool down
# automatically and are skipped instantly by later requests.
# Set any subset of these keys; Pollinations works with no keys at all.
# POLLINATIONS_ENABLED="true"
# POLLINATIONS_BASE_URL="https://text.pollinations.ai/openai"
# POLLINATIONS_MODELS="openai,openai-fast,qwen-coder,deepseek,mistral"
# GROQ_API_KEY=""
# CEREBRAS_API_KEY=""
# OPENROUTER_API_KEY=""
# MISTRAL_API_KEY=""
# HF_TOKEN=""
# GITHUB_TOKEN=""
# TOGETHER_API_KEY=""
# DEEPINFRA_API_KEY=""
# OPENAI_COMPATIBLE_BASE_URL=""
# OPENAI_COMPATIBLE_API_KEY=""
# OPENAI_COMPATIBLE_MODEL=""
# Keyless AI image generation for the media pipeline (default on):
# POLLINATIONS_IMAGE_ENABLED="true"
# POLLINATIONS_IMAGE_BASE_URL="https://image.pollinations.ai"
