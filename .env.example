# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY:
# Configure your Supabase project credentials in Settings > Secrets in AI Studio (backend only).
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# PAYMENT_SECRET_KEY / PAYSTACK_SECRET_KEY:
# Backend-only secret key for live checkout and transaction verification (never expose in client code).
PAYMENT_SECRET_KEY="MY_PAYMENT_SECRET_KEY"
# Optional manual USD -> NGN override (defaults to live market FX rate):
# PAYSTACK_USD_TO_NGN_RATE="1350"

# SERVER-SIDE GEMINI API KEY:
# Add GEMINI_API_KEY from Google AI Studio (aistudio.google.com) in Vercel Environment Variables (or Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# OWNER_ADMIN_EMAIL="preciousowenaze4@gmail.com"

# STAGE 2 (Future): Self-Hosted Open-Source GPU Model Endpoint (inactive in Stage 1):
# SELF_HOSTED_LLM_URL=""
# SELF_HOSTED_LLM_MODEL="self-hosted/open-source-coder"
# SELF_HOSTED_LLM_PROTOCOL="openai_compatible"
# SELF_HOSTED_LLM_API_KEY=""
