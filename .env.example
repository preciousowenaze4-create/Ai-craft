# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Groq free-tier ultra-fast OpenAI-compatible gateway (https://api.groq.com/openai/v1).
# Supports comma-separated backup keys in any *_API_KEY variable or _2 / _3 suffixes.
GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENROUTER_API_KEY: OpenRouter gateway key for :free models (https://openrouter.ai/api/v1).
# Configure in Google AI Studio Secrets or Vercel Environment Variables (never expose in client code).
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# HUGGING_FACE_API_KEY: Hugging Face Inference Providers token (https://router.huggingface.co/v1).
# Also accepts HF_TOKEN / HUGGINGFACE_API_KEY.
HUGGING_FACE_API_KEY="MY_HUGGING_FACE_API_KEY"

# NGROK_API_KEY: ngrok AI Gateway key for https://gateway.ngrok.ai/v1 (optional custom URL via NGROK_AI_GATEWAY_URL).
NGROK_API_KEY="MY_NGROK_API_KEY"

# Optional gateway routing management (defaults to gemini,groq,openrouter,huggingface,ngrok,pollinations):
# AI_GATEWAY_ORDER="gemini,groq,openrouter,huggingface,ngrok,pollinations"
# NGROK_AI_GATEWAY_URL="https://gateway.ngrok.ai/v1"

# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY:
# Configure your Supabase project credentials in Settings > Secrets in AI Studio (backend only).
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# PAYMENT_SECRET_KEY / PAYSTACK_SECRET_KEY:
# Backend-only secret key for live checkout and transaction verification (never expose in client code).
PAYMENT_SECRET_KEY="MY_PAYMENT_SECRET_KEY"
# Optional manual USD -> NGN override (defaults to live market FX rate):
# PAYSTACK_USD_TO_NGN_RATE="1350"

